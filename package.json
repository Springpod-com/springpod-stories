{
  "name": "work-experience-stories",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && tsc --noEmit && node scripts/check-em-dash.mjs",
    "test": "vitest run --project unit --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:ds": "springpod-audit src --json",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test:ai": "RUN_AI_TESTS=1 vitest run --project ai",
    "worker": "tsx --conditions=react-server worker/index.ts",
    "storage:dev": "node scripts/dev-storage.mjs",
    "staff:add": "tsx --conditions=react-server scripts/add-staff.mts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test:upload": "SLOW_TESTS=1 playwright test tests/e2e/large-upload.spec.ts --project=phone",
    "test:stack": "STACK_URL=http://localhost:3000 playwright test tests/e2e/admin.spec.ts tests/e2e/content.spec.ts tests/e2e/media.spec.ts --project=phone",
    "demo:seed": "tsx --conditions=react-server scripts/demo-seed.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/client-transcribe": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@springpod/design-system": "0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "dotenv": "^18.0.7",
    "lucide-react": "0.545.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "pg": "^8.23.1",
    "pg-boss": "12.38.0",
    "playwright-core": "1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "lighthouse": "13.5.0",
    "prisma": "7.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  }
}
