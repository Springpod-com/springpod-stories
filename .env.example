# Postgres (UK or EU region in production)
DATABASE_URL=postgresql://wes:wes@localhost:5432/wes_dev
# Separate database for integration tests (it is wiped before each test)
TEST_DATABASE_URL=postgresql://wes:wes@localhost:5432/wes_test
# Public base URL, used in email links
APP_URL=http://localhost:3000
# Email: "console" logs emails instead of sending them (PRD 21: provider to be chosen)
EMAIL_PROVIDER=console
# Media storage (PRD 7): any S3-compatible bucket in the UK or EU. Leave S3_ENDPOINT unset for AWS.
# Locally, moto stands in for S3: `docker compose up -d s3`, then `pnpm storage:dev`.
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=wes-media-dev
S3_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Speech to text: "fake" (sample text, development only) or "aws" (Amazon Transcribe). Provider to be confirmed.
TRANSCRIBE_PROVIDER=fake
# Staff sign-in for /admin (Auth.js). AUTH_SECRET signs sessions: generate with `openssl rand -base64 32`.
AUTH_SECRET=
# Google Workspace single sign-on. Only addresses on STAFF_EMAIL_DOMAIN that are on the staff list can sign in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
STAFF_EMAIL_DOMAIN=springpod.com
# Development sign-in by email, for local testing before Google is set up. Only works when APP_URL is localhost.
ADMIN_DEV_LOGIN=1
# Who is emailed when a story is held for safeguarding review (PRD 9.4). The admin warns while it is unset.
SAFEGUARDING_LEAD_EMAIL=
# Quote card images: the worker opens the app's render page in headless Chromium.
# RENDER_BASE_URL defaults to APP_URL; CHROMIUM_PATH defaults to Playwright's own Chromium.
# RENDER_SECRET signs the render and card links (defaults to AUTH_SECRET).
RENDER_BASE_URL=
CHROMIUM_PATH=
RENDER_SECRET=
